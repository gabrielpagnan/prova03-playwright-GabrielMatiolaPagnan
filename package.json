{
  "name": "prova03-playwright-gabriel-matiola-pagnan",
  "version": "1.0.0",
  "description": "Tr\u00eas cen\u00e1rios E2E do SauceDemo com Playwright, GitHub Actions e SonarCloud",
  "author": "Gabriel Matiola Pagnan",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('artifacts', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "verify": "prettier --check .",
    "scenario": "playwright test",
    "test": "playwright test",
    "debug": "playwright test --debug",
    "ui": "playwright test --ui",
    "show-report": "npx playwright show-report artifacts/report",
    "actions": "playwright test",
    "ci": "npm run typecheck && npm run verify && npm test",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
